# Copiez ce fichier en .env et remplissez les valeurs
# cp .env.example .env

EXPO_PUBLIC_API_URL=https://votre-api.exemple.com

# Clé TomTom — calcul des itinéraires (Routing API)
EXPO_PUBLIC_TOMTOM_API_KEY=

# Mapbox — https://console.mapbox.com/account/access-tokens/
# Jeton public (pk.…) : lu par l'app au runtime pour afficher la carte
EXPO_PUBLIC_MAPBOX_TOKEN=
# Jeton secret de téléchargement (sk.…) avec le scope DOWNLOADS:READ. Lu directement
# par CocoaPods et Gradle au build natif. Ne jamais committer.
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=
